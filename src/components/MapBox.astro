---
/** Google Maps embed of the restaurant. Reservations + Contact.
 *  Keyless embed form (`?q=...&output=embed`) — no Maps API key required. */
interface Props {
  /** "compact" for the reservations sidebar, "wide" for the contact page.
   *  Controls zoom and box height: the sidebar is narrow, so it pulls in one
   *  step closer to stay legible at that width. */
  variant?: "compact" | "wide";
  label: string;
}
const { variant = "compact", label } = Astro.props;

const ADDRESS = "312 Hanover St, Boston, MA 02113";
const zoom = variant === "wide" ? 15 : 16;
const src = `https://www.google.com/maps?q=${encodeURIComponent(ADDRESS)}&z=${zoom}&output=embed`;
---

<div class="map-box">
  <iframe
    title={`Map of Osteria Vecchia — ${label}`}
    src={src}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"></iframe>
  <span class="maplbl">{label}</span>
</div>
