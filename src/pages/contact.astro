---
import Layout from "../layouts/Layout.astro";
import ImageSlot from "../components/ImageSlot.astro";
import CrumbBar from "../components/CrumbBar.astro";
import MapBox from "../components/MapBox.astro";

const DIRECTIONS = "https://maps.google.com/?q=312+Hanover+St+Boston+MA+02113";
---

<Layout title="Contact — Osteria Vecchia · North End, Boston">
  <CrumbBar
    here="Contact"
    eyebrow="312 Hanover St · Boston"
    title="Come find us in the North End."
    lede="Right in the middle of Hanover Street, a few doors up from the church. Call, email, or just walk in — we'll make room."
  />

  <!-- ===================== MAP + DETAILS ===================== -->
  <section class="section mapembed">
    <div class="wrap">
      <div class="mapembed-grid">
        <MapBox variant="wide" label="312 Hanover St · North End, Boston" />
        <div class="contact-card">
          <h3>Say hello.</h3>
          <div class="contact-row">
            <div class="k">Address</div>
            <div class="v">312 Hanover St<br />Boston, MA 02113</div>
          </div>
          <div class="contact-row">
            <div class="k">Phone</div>
            <div class="v"><a href="tel:+16175550142">617-555-0142</a></div>
          </div>
          <div class="contact-row">
            <div class="k">Email</div>
            <div class="v">
              <a href="mailto:hello@osteriavecchia.com">hello@osteriavecchia.com</a>
            </div>
          </div>
          <div class="contact-row">
            <div class="k">Hours</div>
            <div class="v">Tue – Sun · 5:00 – 10:00 pm<br />Closed Mondays</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT BAR ===================== -->
  <section class="contact-bar">
    <div class="cb-grid">
      <a class="cb-item" href="tel:+16175550142">
        <span class="cb-ico">☎</span>
        <span class="cb-label">Call us</span>
        <span class="cb-value">617-555-0142</span>
      </a>
      <a class="cb-item" href="mailto:hello@osteriavecchia.com">
        <span class="cb-ico">✉</span>
        <span class="cb-label">Email us</span>
        <span class="cb-value">hello@osteriavecchia.com</span>
      </a>
      <a class="cb-item" href={DIRECTIONS} target="_blank" rel="noopener">
        <span class="cb-ico">➤</span>
        <span class="cb-label">Get directions</span>
        <span class="cb-value">312 Hanover St</span>
      </a>
    </div>
  </section>

  <!-- ===================== LOCATION CARDS ===================== -->
  <section class="section locations">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Where to find us</p>
        <h2>Find us.</h2>
      </div>
      <div class="loc-grid">
        <div class="loc-card">
          <h3>North End</h3>
          <p class="loc-tag">Our home since 1987</p>
          <div class="loc-row">
            <div class="k">Address</div>
            <div class="v">312 Hanover St<br />Boston, MA 02113</div>
          </div>
          <div class="loc-row">
            <div class="k">Phone</div>
            <div class="v"><a href="tel:+16175550142">617-555-0142</a></div>
          </div>
          <div class="loc-row">
            <div class="k">Hours</div>
            <div class="v">Tue – Sun · 5:00 – 10:00 pm<br />Closed Mondays</div>
          </div>
          <div class="loc-link">
            <a class="text-link" href={DIRECTIONS} target="_blank" rel="noopener">
              Get directions →
            </a>
          </div>
        </div>
        <div class="loc-card placeholder">
          <div class="ph-mark">Presto</div>
          <p>
            A second location is in the works. Watch this space — we'll add it
            here when the doors open.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER CTA ===================== -->
  <section class="footer-cta">
    <ImageSlot
      src="/photos/interior-night.webp"
      alt="A long table set with candles down the middle, glowing in a dark dining room"
    />
    <div class="fcta-scrim"></div>
    <div class="wrap">
      <p class="eyebrow">Still hungry?</p>
      <h2>Reserve your table tonight.</h2>
      <p>
        The pasta's fresh, the oven's hot, and there's a table with your name on
        it. Don't wait for the weekend rush.
      </p>
      <a class="btn" href="/reservations/">Book a Table</a>
    </div>
  </section>
</Layout>
